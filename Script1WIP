-- ayni anahtarla tekrar gelen bildirimler tek satirda birlesir: "... x16"
local notifyActive = {}
local NOTIFY_FONTS = {
	Standart = Enum.Font.GothamMedium, Doors = Enum.Font.Antique, STX = Enum.Font.Code, Library = Enum.Font.Fantasy,
}
local function notify(text, kind, key, shortText)
	key = key or text -- ayni metin = ayni bildirim
	local life = S.keepNotif and 30 or 4
	local act = notifyActive[key]
	if act and act.f.Parent and os.clock() - act.t < life then
		act.n += 1
		act.t = os.clock()
		act.lbl.Text = (shortText or text) .. "  x" .. act.n
		return act
	end
	local color = ({ ok = T.ok, warn = T.warn, bad = T.bad, info = T.info, entity = T.orange })[kind or "info"] or T.info
	local f = new("Frame", {
		Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = T.panel, BackgroundTransparency = 1,
		BorderSizePixel = 0, NoBind = true,
	}, notifyHolder)
	round(f, 8)
	local st = new("UIStroke", { Color = color, Thickness = 1, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, NoBind = true }, f)
	local lbl = new("TextLabel", {
		Size = UDim2.new(1, -16, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1,
		Text = text, TextColor3 = T.text, TextTransparency = 1, Font = NOTIFY_FONTS[S.notifyStyle] or Enum.Font.GothamMedium, TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, NoBind = true,
	}, f)
	tween(f, 0.2, { BackgroundTransparency = 0.05 })
	tween(lbl, 0.2, { TextTransparency = 0 })
	tween(st, 0.2, { Transparency = 0 })
	local entry = { f = f, lbl = lbl, n = 1, t = os.clock() }
	notifyActive[key] = entry
	-- ekranda en fazla 6 bildirim: fazlasinda en eskisi silinir
	local frames = {}
	for _, c in ipairs(notifyHolder:GetChildren()) do
		if c:IsA("Frame") then table.insert(frames, c) end
	end
	if #frames > 6 then frames[1]:Destroy() end
	local function fade()
		if not f.Parent then return end
		local left = life - (os.clock() - entry.t)
		if left > 0.05 then task.delay(left, fade); return end
		tween(f, 0.25, { BackgroundTransparency = 1 })
		tween(lbl, 0.25, { TextTransparency = 1 })
		tween(st, 0.25, { Transparency = 1 })
		task.wait(0.3)
		f:Destroy()
	end
	task.delay(life, fade)
	return entry
end

