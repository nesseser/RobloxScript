local ents = {}
-- anahtar kelimeler ve sonuclar onbellekte: ayni isim tekrar tekrar sorulur (oda gecislerinde binlerce kez)
local kwCache, hitCache = {}, {}
local function listHas(listStr, name)
	local kws = kwCache[listStr]
	if not kws then
		kws = {}
		for kw in listStr:lower():gmatch("[^,%s]+") do kws[#kws + 1] = kw end
		kwCache[listStr] = kws
	end
	if #kws == 0 then return false end
	local hc = hitCache[listStr]
	if not hc then
		hc = {}
		hitCache[listStr] = hc
	end
	local r = hc[name]
	if r == nil then
		local l = name:lower()
		r = false
		for _, kw in ipairs(kws) do
			if l:find(kw, 1, true) then r = true break end
		end
		if #name < 60 then hc[name] = r end
	end
	return r
end
local function entPos(inst)
	if inst:IsA("Model") then return inst:GetPivot().Position end
	return inst.Position
end
local function untrackEntity(inst)
	local o = ents[inst]
	if o then
		if o.hl then o.hl:Destroy() end
		if o.bb then o.bb:Destroy() end
		ents[inst] = nil
	end
end
local function clearEntities() for i in pairs(ents) do untrackEntity(i) end end

