local function isFakeDoor(inst)
	local a = inst
	while a and a ~= workspace do
		if listHas(S.fakeWords, a.Name) then return true end
		a = a.Parent
	end
	return false
end

local CAT_ICON = { entity = "☠ ", door = "🚪 ", hide = "🗄 ", item = "★ ", chest = "📦 ",
	currency = "💰 ", ladder = "🪜 ", objective = "🎯 ", misc = "• " }

local function makeHl(inst, color)
	return new("Highlight", {
		Adornee = inst, FillColor = color, FillTransparency = 0.55, OutlineColor = color,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, NoBind = true,
	}, gui)
end

local function trackEntity(inst, silent)
	if ents[inst] or not inst.Parent or not S.entOn then return end
	local cat, danger = classify(inst)
	if not cat then return end
	-- zaten izlenen bir modelin icindeyse atla (dolabin kapagi gibi)
	local a = inst.Parent
	while a and a ~= workspace do
		if ents[a] then return end
		a = a.Parent
	end
	local part = inst:IsA("BasePart") and inst or inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)
	if not part then return end

	local pc = PAL[S.colIdx[cat] or 8][2]
	local color = cat == "entity" and (danger and pc or T.orange) or pc
	local fake = cat == "door" and isFakeDoor(inst)
	if fake then color = T.bad end
	local o = { part = part, cat = cat, color = color, fake = fake }
	local db = ENT_DB[inst.Name]
	local shown = cat == "door" and (fake and "Sahte kapı" or "Kapı") or (db and db.alias) or inst.Name
	if #shown > 18 then shown = shown:sub(1, 16) .. "…" end
	o.text = (danger and "☠ " or CAT_ICON[cat]) .. shown
	ents[inst] = o
	-- once alt parcalar izlendiyse (door frame vb.), sadece en dis kapiyi birak
	for other in pairs(ents) do
		if other ~= inst and other:IsDescendantOf(inst) then untrackEntity(other) end
	end

	if cat == "item" and S.notifyItems and not silent then
		local mr = getRoot()
		local d = mr and math.floor((part.Position - mr.Position).Magnitude + 0.5) or 0
		notify("★ " .. inst.Name .. " (" .. d .. " stud)", "info", "item:" .. inst.Name, "★ " .. inst.Name)
	end
	if cat == "entity" and not silent and S.notifyEnt
		and not (db and S.entMute ~= "" and listHas(S.entMute, db.alias)) then
		local myRoot = getRoot()
		local dist = myRoot and math.floor((part.Position - myRoot.Position).Magnitude + 0.5) or 0
		local prefix = (danger and "☠ TEHLİKE: " or "⚠ ") .. inst.Name .. " spawn oldu"
		local full = prefix .. " (" .. dist .. " stud)"
		if db then
			prefix = "☠ " .. db.title
			full = prefix .. " " .. db.body .. " (" .. dist .. " stud)"
		end
		local entry = notify(full, danger and "bad" or "entity", "ent:" .. inst.Name, prefix)
		if entry.n == 1 then
			addLog("entity", inst:GetFullName() .. " spawn oldu (" .. dist .. " stud)" .. (danger and "  [TEHLIKE]" or ""))
		end
		playAlert(danger)
		if S.entChat and entry.n == 1 then
			pcall(function()
