-- EXPLORER: oyunun dosya agacini gez, incele, ozellik oku (hepsi yerel)
do
	local SERVICES = { "Workspace", "ReplicatedStorage", "Lighting", "StarterGui", "StarterPack", "Players", "ReplicatedFirst", "SoundService", "Teams", "game" }
	local rootIdx, selected, searchResults, searching = 1, nil, nil, false
	local expanded, rowMap, hlMap, hideOrig, colOrig = {}, {}, {}, {}, {}

	local function svc(name)
		if name == "game" then return game end
		local ok, s = pcall(game.GetService, game, name)
		return ok and s or nil
	end
	local function esc(s)
		s = s:gsub("&", "&amp;")
		s = s:gsub("<", "&lt;")
		s = s:gsub(">", "&gt;")
		return s
	end
	local function posOf(inst)
		if inst:IsA("BasePart") then return inst.Position end
		if inst:IsA("Model") then return inst:GetPivot().Position end
		if inst:IsA("Attachment") then return inst.WorldPosition end
		local p = inst:FindFirstChildWhichIsA("BasePart", true)
		return p and p.Position
	end
	local function partsOf(inst)
		local list = {}
		if inst:IsA("BasePart") then list[1] = inst end
		for _, d in ipairs(inst:GetDescendants()) do
			if d:IsA("BasePart") then list[#list + 1] = d end
		end
		return list
	end
	local function fv(v)
		local t = typeof(v)
		if t == "Vector3" then return string.format("%.1f, %.1f, %.1f", v.X, v.Y, v.Z) end
		if t == "number" then return string.format("%.4g", v) end
		if t == "Instance" then return v:GetFullName() end
		return tostring(v)
	end

	local function describe(inst)
		local L = {
			"Ad: " .. inst.Name, "Sınıf: " .. inst.ClassName, "Yol: " .. inst:GetFullName(), "Çocuk: " .. #inst:GetChildren(),
		}
		local function add(name)
			local ok, v = pcall(function() return inst[name] end)
			if ok and v ~= nil then L[#L + 1] = name .. ": " .. fv(v) end
		end
		local function addAll(names) for _, n in ipairs(names) do add(n) end end
		if inst:IsA("BasePart") then
			addAll({ "Position", "Size", "Anchored", "CanCollide", "CanTouch", "Transparency", "Material" })
		elseif inst:IsA("Model") then
			L[#L + 1] = "Konum: " .. fv(inst:GetPivot().Position)
			add("PrimaryPart")
		elseif inst:IsA("Humanoid") then
			addAll({ "Health", "MaxHealth", "WalkSpeed", "JumpPower" })
		elseif inst:IsA("ValueBase") then
			add("Value")
		elseif inst:IsA("ProximityPrompt") then
			addAll({ "ActionText", "ObjectText", "HoldDuration", "MaxActivationDistance", "Enabled" })
		elseif inst:IsA("ClickDetector") then
			add("MaxActivationDistance")
		elseif inst:IsA("Sound") then
			addAll({ "SoundId", "Volume", "Playing" })
		elseif inst:IsA("GuiObject") then
			addAll({ "Visible", "Text" })
		elseif inst:IsA("Tool") then
			addAll({ "CanBeDropped", "RequiresHandle" })
		end
		for k, v in pairs(inst:GetAttributes()) do L[#L + 1] = "@" .. k .. ": " .. fv(v) end
		return table.concat(L, "\n")
	end

	------------------------------------------------------------------ arayuz
	local rootBtn = new("TextButton", {
		Size = UDim2.fromOffset(150, 30), BackgroundColor3 = T.card, TextColor3 = T.text, Font = Enum.Font.GothamMedium,
		TextSize = 12, AutoButtonColor = false, Text = "",
	}, pExp)
	round(rootBtn, 6)
	local searchBox = new("TextBox", {
		Size = UDim2.new(1, -234, 0, 30), Position = UDim2.fromOffset(156, 0), BackgroundColor3 = T.card, TextColor3 = T.text,
		PlaceholderText = "isim ara (Enter)", PlaceholderColor3 = T.sub, Text = "", Font = Enum.Font.Code, TextSize = 12,
		ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
	}, pExp)
	round(searchBox, 6)
	new("UIPadding", { PaddingLeft = UDim.new(0, 8) }, searchBox)
	local refreshBtn = new("TextButton", {
		Size = UDim2.fromOffset(72, 30), Position = UDim2.new(1, -72, 0, 0), BackgroundColor3 = T.accent, TextColor3 = Color3.new(1, 1, 1),
		Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = false, Text = "🔄 Yenile",
	}, pExp)
	round(refreshBtn, 6)

	local tree = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 170), Position = UDim2.fromOffset(0, 36), BackgroundColor3 = T.bg, BorderSizePixel = 0,
		ScrollBarThickness = 4, ScrollBarImageColor3 = T.stroke, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
	}, pExp)
	round(tree, 8)
	stroke(tree)
	new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, tree)

	local infoBox = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 84), Position = UDim2.fromOffset(0, 212), BackgroundColor3 = T.card, BorderSizePixel = 0,
		ScrollBarThickness = 3, ScrollBarImageColor3 = T.stroke, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
	}, pExp)
	round(infoBox, 8)
	local infoLbl = new("TextLabel", {
		Size = UDim2.new(1, -12, 0, 0), Position = UDim2.fromOffset(8, 4), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		TextWrapped = true, TextColor3 = T.text, Font = Enum.Font.Code, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, Text = "Bir öğe seç.",
	}, infoBox)

	local btnGrid = new("Frame", { Size = UDim2.new(1, 0, 1, -302), Position = UDim2.fromOffset(0, 302), BackgroundTransparency = 1 }, pExp)
	new("UIGridLayout", { CellSize = UDim2.new(0.25, -4, 0, 32), CellPadding = UDim2.fromOffset(4, 4) }, btnGrid)

	------------------------------------------------------------------ agac
	local rebuild
	local function select(inst)
		local prev = selected
		selected = inst
		if prev and rowMap[prev] then rowMap[prev].BackgroundTransparency = 1 end
		if inst and rowMap[inst] then rowMap[inst].BackgroundTransparency = 0.5 end
		infoLbl.Text = inst and describe(inst) or "Bir öğe seç."
	end

	local function flatten(inst, depth, out)
		local kids = inst:GetChildren()
		table.sort(kids, function(a, b) return a.Name:lower() < b.Name:lower() end)
		for i, c in ipairs(kids) do
			if #out > 400 then return end
			if i > 150 then
				out[#out + 1] = { more = #kids - 150, depth = depth }
				break
			end
			out[#out + 1] = { inst = c, depth = depth }
			if expanded[c] then flatten(c, depth + 1, out) end
		end
	end

	function rebuild()
		for _, c in ipairs(tree:GetChildren()) do
			if c:IsA("GuiObject") then c:Destroy() end
		end
		table.clear(rowMap)
		local out = {}
		if searchResults then
			for _, inst in ipairs(searchResults) do out[#out + 1] = { inst = inst, depth = 0, path = true } end
		else
			local r = svc(SERVICES[rootIdx])
			if r then flatten(r, 0, out) end
		end
		rootBtn.Text = searchResults and ("Arama: " .. #searchResults) or ("Kök: " .. SERVICES[rootIdx] .. " ▾")
		for i, e in ipairs(out) do
			local b = new("TextButton", {
				Size = UDim2.new(1, -6, 0, 20), BackgroundColor3 = T.accent, BackgroundTransparency = 1, Text = "",
				AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = i,
			}, tree)
			local indent = e.depth * 14
			if e.more then
				new("TextLabel", {
					Size = UDim2.new(1, -indent - 20, 1, 0), Position = UDim2.fromOffset(indent + 20, 0), BackgroundTransparency = 1,
					Text = "… " .. e.more .. " öğe daha", TextColor3 = T.sub, Font = Enum.Font.Gotham, TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
				}, b)
			else
				local inst = e.inst
				rowMap[inst] = b
				if inst == selected then b.BackgroundTransparency = 0.5 end
				local hasKids = #inst:GetChildren() > 0
				if hasKids and not e.path then
					local arrow = new("TextButton", {
						Size = UDim2.fromOffset(18, 20), Position = UDim2.fromOffset(indent, 0), BackgroundTransparency = 1,
						Text = expanded[inst] and "▾" or "▸", TextColor3 = T.sub, Font = Enum.Font.GothamBold, TextSize = 12,
					}, b)
					arrow.MouseButton1Click:Connect(function()
						expanded[inst] = not expanded[inst] or nil
						rebuild()
					end)
				end
				local label = esc(inst.Name) .. "  <font color='#" .. T.sub:ToHex() .. "' size='10'>"
					.. inst.ClassName .. (e.path and ("  " .. esc(inst:GetFullName())) or "") .. "</font>"
				new("TextLabel", {
					Size = UDim2.new(1, -indent - 20, 1, 0), Position = UDim2.fromOffset(indent + 20, 0), BackgroundTransparency = 1,
					RichText = true, Text = label, TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				}, b)
				b.MouseButton1Click:Connect(function() select(inst) end)
			end
		end
	end

	rootBtn.MouseButton1Click:Connect(function()
		rootIdx = rootIdx % #SERVICES + 1
		searchResults = nil
		rebuild()
	end)
	refreshBtn.MouseButton1Click:Connect(function()
		rebuild()
		if selected and selected.Parent then select(selected) end
	end)
	searchBox.FocusLost:Connect(function()
		local q = searchBox.Text:lower()
		if q == "" then
			searchResults = nil
			rebuild()
			return
		end
		if searching then return end
		searching = true
		task.spawn(function()
			local res, n = {}, 0
			local r = svc(SERVICES[rootIdx])
			if r then
				for _, d in ipairs(r:GetDescendants()) do
					if d.Name:lower():find(q, 1, true) then
						res[#res + 1] = d
						if #res >= 200 then break end
					end
					n += 1
					if n % 3000 == 0 then task.wait() end
				end
			end
			searchResults = res
			searching = false
			rebuild()
		end)
	end)

	------------------------------------------------------------------ eylemler
	local function actBtn(text, cb)
		local b = new("TextButton", {
			BackgroundColor3 = T.card, Text = text, TextColor3 = T.text, Font = Enum.Font.GothamMedium, TextSize = 11, AutoButtonColor = false,
		}, btnGrid)
		round(b, 6)
		stroke(b)
		b.MouseButton1Click:Connect(function()
			if not selected or not selected.Parent then notify("Önce bir öğe seç", "warn") return end
			cb(selected)
		end)
	end

	actBtn("📍 Git", function(inst)
		local p = posOf(inst)
		if p then teleportTo(CFrame.new(p + Vector3.new(0, 4, 0))) else notify("Konumu yok", "warn") end
	end)
	actBtn("✨ Parlat", function(inst)
		if hlMap[inst] then
			hlMap[inst]:Destroy()
			hlMap[inst] = nil
		elseif inst:IsA("PVInstance") then
			hlMap[inst] = new("Highlight", {
				Adornee = inst, FillColor = T.accent, OutlineColor = Color3.new(1, 1, 1), FillTransparency = 0.5,
				DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, NoBind = true,
			}, gui)
		else
			notify("Bu tür parlatılamaz (Model / Part olmalı)", "warn")
		end
	end)
	actBtn("👁 Gizle/Göster", function(inst)
		local parts = partsOf(inst)
		if #parts == 0 then notify("Part yok", "warn") return end
		local hidden = hideOrig[inst]
		if hidden then
			for p, t in pairs(hidden) do
				if p.Parent then p.Transparency = t end
			end
			hideOrig[inst] = nil
		else
			local map = {}
			for _, p in ipairs(parts) do
				map[p] = p.Transparency
				p.Transparency = 1
			end
			hideOrig[inst] = map
		end
	end)
	actBtn("🚧 Çarpışma", function(inst)
		local parts = partsOf(inst)
		if #parts == 0 then notify("Part yok", "warn") return end
		local orig = colOrig[inst]
		if orig then
			for p, c in pairs(orig) do
				if p.Parent then p.CanCollide = c end
			end
			colOrig[inst] = nil
		else
			local map = {}
			for _, p in ipairs(parts) do
				map[p] = p.CanCollide
				p.CanCollide = false
			end
			colOrig[inst] = map
		end
	end)
	actBtn("📋 Yolu kopyala", function(inst)
		local path = inst:GetFullName()
		if typeof(setclipboard) == "function" then
			setclipboard(path)
			notify("Yol kopyalandı", "ok")
		else
			searchBox.Text = path
			notify("setclipboard yok: yol arama kutusuna yazıldı, oradan kopyala", "info")
		end
	end)
	actBtn("🗑 Yerelde sil", function(inst)
		local char = player.Character
		if inst.Parent == game or inst == char or (char and inst:IsAncestorOf(char)) or inst:IsAncestorOf(gui)
			or inst == workspace.CurrentCamera or inst:IsDescendantOf(player) then
			notify("Bu öğe silinemez (servis / karakter / panel)", "bad")
			return
		end
		inst:Destroy()
		select(nil)
		rebuild()
		notify("Yerelde silindi (sunucuda durur)", "ok")
	end)
	actBtn("🎒 Çantaya ver", function(inst)
		if not inst:IsA("Tool") then notify("Sadece Tool verilebilir", "warn") return end
		local bp = player:FindFirstChildOfClass("Backpack")
		if bp then
			inst:Clone().Parent = bp
			notify(inst.Name .. " çantana eklendi (yerel)", "ok")
		end
	end)
	actBtn("⚡ Tetikle", function(inst)
		if inst:IsA("ProximityPrompt") then
			pcall(function()
				if typeof(fireproximityprompt) == "function" then
					fireproximityprompt(inst)
				else
					inst:InputHoldBegin()
					task.wait(inst.HoldDuration + 0.1)
					inst:InputHoldEnd()
				end
			end)
		elseif inst:IsA("ClickDetector") and typeof(fireclickdetector) == "function" then
			pcall(fireclickdetector, inst)
		else
			notify("ProximityPrompt veya ClickDetector seç", "warn")
		end
	end)

	rebuild()
end

-- BYPASS: bilinen oyun nesnelerinin dokunmasini / carpismasini kapat (hepsi yerel)
do
	local function eachPart(obj, fn)
		if obj:IsA("BasePart") then fn(obj) end
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("BasePart") then fn(d) end
		end
	end
	local function touch(o, on) eachPart(o, function(p) p.CanTouch = not on end) end

	local ORDER = {
		"bpGiggle", "bpDupe", "bpGloom", "bpSeekObs", "bpVacuum", "bpLava", "bpScary", "bpSnare", "bpBanana", "bpJeff",
		"bpWater", "bpAlma", "bpDrones", "bpScribbles",
	}
	local DEFS = {
		bpGiggle = { text = "Bypass Giggle (GiggleCeiling)", names = { "GiggleCeiling" }, apply = function(o, on)
			local h = o:FindFirstChild("Hitbox")
			if h then h.CanTouch = not on end
		end },
		bpDupe = { text = "Bypass Dupe (sahte kapılar)", names = { "DoorFake", "FakeDoor" }, apply = function(o, on)
			local h = o:FindFirstChild("Hidden")
			if h then h.CanTouch = not on end
			local lock = o:FindFirstChild("Lock")
			local up = lock and lock:FindFirstChild("UnlockPrompt")
			if up then up.Enabled = not on end
		end },
		bpGloom = { text = "Bypass Gloombat yumurtaları", names = { "GloombatEgg", "GloomEgg" }, apply = touch },
		bpSeekObs = { text = "Bypass Seek engelleri", names = { "SeekFloodline", "Seek_Arm", "Seek_Hand", "ChandelierObstruction", "SeekObstruction" },
			apply = function(o, on)
				touch(o, on)
				if o.Name == "SeekFloodline" then eachPart(o, function(p) p.CanCollide = on end) end
			end },
		bpVacuum = { text = "Bypass Vacuum (SideroomSpace)", names = { "SideroomSpace" }, apply = function(o, on)
			local c = o:FindFirstChild("Collision")
			if c then
				c.CanCollide = on
				c.CanTouch = not on
			end
		end },
		bpLava = { text = "Bypass Killbricks (Lava)", names = { "Lava" }, apply = touch },
		bpScary = { text = "Bypass Seeking Wall (ScaryWall)", names = { "ScaryWall" }, apply = function(o, on)
			eachPart(o, function(p)
				p.CanTouch = not on
				p.CanCollide = not on
			end)
		end },
		bpSnare = { text = "Bypass Snare", names = { "Snare" }, apply = touch },
		bpBanana = { text = "Bypass Banana Peel", names = { "BananaPeel" }, apply = touch },
		bpJeff = { text = "Bypass Jeff the Killer", names = { "JeffTheKiller" }, apply = function(o, on)
			eachPart(o, function(p)
				p.CanCollide = not on
				p.CanTouch = not on
			end)
			local h = o:FindFirstChildOfClass("Humanoid")
			if on and h then h.Health = 0 end
		end },
	}
	-- Archives
	DEFS.bpWater = { text = "Bypass Electric Water", names = { "ElectricWater", "Electric_Water" }, apply = touch }
	DEFS.bpAlma = { text = "Bypass Alma (doğmasını engelle)", names = { "Alma", "AlmaMoving" }, apply = function(o, on)
		if on then o:Destroy() end
	end }
	DEFS.bpDrones = { text = "Bypass Drones", names = { "DronesStampede", "Drones", "Drone" }, apply = touch }
	DEFS.bpScribbles = { text = "Bypass Scribbles", names = { "Scribbles" }, apply = touch }

	-- Remove: doğmasını engelle (model oluşunca yerelde silinir)
	local function removeDef(text, names)
		return { text = text, names = names, apply = function(o, on) if on then o:Destroy() end end }
	end
	DEFS.rmScreech = removeDef("Remove Screech", { "Screech" })
	DEFS.rmHalt = removeDef("Remove Halt", { "Halt", "Shade" })
	DEFS.rmA90 = removeDef("Remove A-90", { "A90", "A-90" })
	DEFS.rmDread = removeDef("Remove Dread", { "Dread" })
	DEFS.rmSurge = removeDef("Remove Surge", { "Surge" })
	for _, k in ipairs({ "rmScreech", "rmHalt", "rmA90", "rmDread", "rmSurge" }) do table.insert(ORDER, k) end

	local byName = {}
	for key, def in pairs(DEFS) do
		for _, n in ipairs(def.names) do
			byName[n] = byName[n] or {}
			table.insert(byName[n], key)
		end
	end

	local function rescan(key)
		local def = DEFS[key]
		local lookup = {}
		for _, n in ipairs(def.names) do lookup[n] = true end
		task.spawn(function()
			local n = 0
			for _, d in ipairs(workspace:GetDescendants()) do
				if lookup[d.Name] then pcall(def.apply, d, S[key] and true or false) end
				n += 1
				if n % 2000 == 0 then task.wait() end
			end
		end)
	end
	X.onAdded(function(d)
		local keys = byName[d.Name]
		if keys then
			for _, k in ipairs(keys) do
				if S[k] then pcall(DEFS[k].apply, d, true) end
			end
		end
	end)

	addSection(pPlayer, "Bypass (tuzak / yaratık)")
	for _, key in ipairs(ORDER) do
		addToggle(pPlayer, DEFS[key].text, false, function(v)
			S[key] = v
			rescan(key)
		end, key)
	end

	-- No ... Damage: gercek remote'u klasorden cikarip yerine ayni adli sahte remote koy (sunucuya hic ulasmaz)
	local stash = {}
	local function remotesFolder()
		return ReplicatedStorage:FindFirstChild("RemotesFolder") or ReplicatedStorage:FindFirstChild("Remotes")
	end
	local function swapRemote(name, on)
		local rf = remotesFolder()
		if not rf then notify("RemotesFolder bulunamadı", "warn") return end
		local rec = stash[name]
		if on then
			if rec then return end
			local real = rf:FindFirstChild(name)
			if not real then notify("'" .. name .. "' remote'u bulunamadı", "warn") return end
			local fake = Instance.new(real.ClassName)
			fake.Name = real.Name
			stash[name] = { real = real, fake = fake }
			real.Parent = nil
			fake.Parent = rf
		elseif rec then
			rec.fake:Destroy()
			rec.real.Parent = rf
			stash[name] = nil
		end
	end
	for _, d in ipairs({
		{ "noScreechDmg", "No Screech Damage", "Screech" },
		{ "noHaltDmg", "No Halt Damage", "Shade" },
		{ "noA90Dmg", "No A-90 Damage", "A90" },
		{ "noSurgeDmg", "No Surge Damage", "SurgeRemote" },
	}) do
		addToggle(pPlayer, d[2], false, function(v)
			S[d[1]] = v
			swapRemote(d[3], v)
		end, d[1])
	end

	-- workspace'e dogrudan eklenen cop / fidye nesnelerini sil
	addToggle(pPlayer, "Anti Closet Trash (Binder / Shoe / Shelf sil)", false, function(v) S.antiTrash = v end, "antiTrash")
	addToggle(pPlayer, "Anti Ransom (Ransom sil)", false, function(v) S.antiRansom = v end, "antiRansom")
	X.onAdded(function(d)
		if d.Parent ~= workspace then return end
		local n = d.Name
		if S.antiTrash and (n:sub(1, 6) == "Binder" or n:sub(1, 4) == "Shoe" or n:sub(1, 5) == "Shelf") then
			d:Destroy()
		elseif S.antiRansom and n == "Ransom" then
			d:Destroy()
		end
	end)

	-- ForgetMeNot: yapistirdigin kodun sadece gorunen kismi (FireLookAts). Sonrasi kesik oldugu icin oda gecisi / void kismi yok.
	local fmnDone = setmetatable({}, { __mode = "k" })
	addToggle(pPlayer, "ForgetMeNot solver (LookAt gönder)", false, function(v)
		S.fmn = v
		if v then table.clear(fmnDone) end
	end, "fmn")
	task.spawn(function()
		while true do
			task.wait(0.5)
			local rooms = S.fmn and workspace:FindFirstChild("CurrentRooms")
			if rooms then
				for _, room in ipairs(rooms:GetChildren()) do
					if not fmnDone[room] and room:FindFirstChild("ForgetMeNotVineDoors", true) then
						fmnDone[room] = true
						for i = 1, 6 do
							local obj = room:FindFirstChild(tostring(i))
							local la = obj and obj:FindFirstChild("LookAt")
							if la and la:IsA("RemoteEvent") then pcall(function() la:FireServer() end) end
						end
						notify("ForgetMeNot: LookAt gönderildi (oda " .. room.Name .. ")", "ok")
					end
				end
			end
		end
	end)

	-- Eyes / Lookman: oyunun MotorReplication remote'una sahte bakis acisi gonder
	addToggle(pPlayer, "Bypass Eyes (remote)", false, function(v) S.bpEyes = v end, "bpEyes")
	addToggle(pPlayer, "Bypass Lookman (remote)", false, function(v) S.bpLookman = v end, "bpLookman")
	addToggle(pPlayer, "Eyes/Lookman: eski kat varyantı (Fools / OldHotel)", false, function(v) S.bpOldFloor = v end, "bpOldFloor")
	local function motorRemote()
		local rf = ReplicatedStorage:FindFirstChild("RemotesFolder") or ReplicatedStorage:FindFirstChild("Remotes")
		return rf and rf:FindFirstChild("MotorReplication")
	end
	local function present(names)
		for inst, o in pairs(ents) do
			if o.cat == "entity" and names[inst.Name] then return true end
		end
		return false
	end
	task.spawn(function()
		local warned = false
		while true do
			task.wait(0.3)
			local want = (S.bpEyes and present({ Eyes = true })) or (S.bpLookman and present({ Lookman = true, BackdoorLookman = true }))
			if want then
				local r = motorRemote()
				if r then
					pcall(function()
						if S.bpOldFloor then r:FireServer(0, -65, 0, false) else r:FireServer(-650) end
					end)
				elseif not warned then
					warned = true
					notify("MotorReplication remote'u bulunamadı (ReplicatedStorage.RemotesFolder)", "warn")
				end
			end
		end
	end)
end

-- KAMERA / EFEKT / ESP RENKLERI / BILDIRIM / DEBUG (yerel ozellikler)
do
	local amb0, out0 = Lighting.Ambient, Lighting.OutdoorAmbient
	local atmWas = false

	------------------------------------------------------------ kamera
	addSection(pVis, "Kamera / Ortam")
	addToggle(pVis, "Ambient rengi", false, function(v)
		S.ambientOn = v
		if not v then Lighting.Ambient, Lighting.OutdoorAmbient = amb0, out0 end
	end, "ambientOn")
	addSlider(pVis, "Ambient R", 0, 255, S.ambR, function(v) S.ambR = v end, 1, "ambR")
	addSlider(pVis, "Ambient G", 0, 255, S.ambG, function(v) S.ambG = v end, 1, "ambG")
	addSlider(pVis, "Ambient B", 0, 255, S.ambB, function(v) S.ambB = v end, 1, "ambB")
	addToggle(pVis, "Kamera sarsıntısını kaldır", false, function(v) S.noShake = v end, "noShake")
	addToggle(pVis, "Üçüncü şahıs", false, function(v)
		S.thirdPerson = v
		if not v then
			local c = getChar()
			if c then
				for _, p in ipairs(c:GetDescendants()) do
					if p:IsA("BasePart") then p.LocalTransparencyModifier = 0 end
				end
			end
		end
	end, "thirdPerson")
	addSlider(pVis, "3. şahıs X", -20, 20, S.tpX, function(v) S.tpX = v end, 0.5, "tpX")
	addSlider(pVis, "3. şahıs Y", -20, 20, S.tpY, function(v) S.tpY = v end, 0.5, "tpY")
	addSlider(pVis, "3. şahıs Z (geri)", 0, 60, S.tpZ, function(v) S.tpZ = v end, 0.5, "tpZ")
	addToggle(pVis, "3. şahıs duvar kontrolü", true, function(v) S.tpWall = v end, "tpWall")

	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	RunService:BindToRenderStep("HunterCam2", Enum.RenderPriority.Camera.Value + 2, function()
		if S.ambientOn then
			local c = Color3.fromRGB(S.ambR, S.ambG, S.ambB)
			Lighting.Ambient, Lighting.OutdoorAmbient = c, c
		end
		local hum = getHum()
		if S.noShake and hum and hum.CameraOffset ~= Vector3.zero then hum.CameraOffset = Vector3.zero end
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then
			if S.noFog then
				X.atm0 = X.atm0 or atm.Density
				atm.Density = 0
				atmWas = true
			elseif atmWas then
				atm.Density = X.atm0 or atm.Density
				atmWas = false
			end
		end
		if S.thirdPerson then
			local cam, char = workspace.CurrentCamera, getChar()
			if cam and char then
				for _, p in ipairs(char:GetChildren()) do
					if p:IsA("BasePart") then p.LocalTransparencyModifier = 0 end
				end
				local origin = cam.CFrame.Position
				local want = (cam.CFrame * CFrame.new(S.tpX, S.tpY, S.tpZ)).Position
				if S.tpWall then
					rp.FilterDescendantsInstances = { char }
					local hit = workspace:Raycast(origin, want - origin, rp)
					if hit then
						local back = origin - want
						want = hit.Position + (back.Magnitude > 0.01 and back.Unit or Vector3.zero) * 0.5
					end
				end
				cam.CFrame = CFrame.new(want) * (cam.CFrame - cam.CFrame.Position)
			end
		end
	end)

	------------------------------------------------------------ efektler
	addSection(pVis, "Efektler")
	local hsOrig, fxOrig = {}, {}
	addToggle(pVis, "Saklanma yerlerini şeffaf yap", false, function(v)
		S.hideSpotTrans = v
		if not v then
			for p, t in pairs(hsOrig) do
				if p.Parent then p.Transparency = t end
			end
			table.clear(hsOrig)
		end
	end, "hideSpotTrans")
	addSlider(pVis, "Şeffaflık", 0, 1, S.hideSpotAlpha, function(v) S.hideSpotAlpha = v end, 0.05, "hideSpotAlpha")
	addToggle(pVis, "Jumpscare / vinyet / glitch efektlerini kapat", false, function(v)
		S.fxOff = v
		if not v then
			for o, prop in pairs(fxOrig) do
				if o.Parent then
					if prop == "Enabled" then o.Enabled = true else o.Visible = true end
				end
			end
			table.clear(fxOrig)
		end
	end, "fxOff")
	addTextBox(pVis, "Efekt adları:", S.fxNames, function(t) S.fxNames = t end, "fxNames")
	task.spawn(function()
		while true do
			task.wait(1)
			if S.hideSpotTrans then
				for inst, o in pairs(ents) do
					if o.cat == "hide" and (o.dist or 1e9) < 150 and inst:IsDescendantOf(workspace) then
						local function set(p)
							if p:IsA("BasePart") then
								if hsOrig[p] == nil then hsOrig[p] = p.Transparency end
								p.Transparency = math.max(hsOrig[p], S.hideSpotAlpha)
							end
						end
						set(inst)
						for _, d in ipairs(inst:GetDescendants()) do set(d) end
					end
				end
			end
			if S.fxOff then
				local pg = player:FindFirstChildOfClass("PlayerGui")
				if pg then
					for _, d in ipairs(pg:GetDescendants()) do
						if listHas(S.fxNames, d.Name) and not d:IsDescendantOf(gui) then
							if d:IsA("GuiObject") and d.Visible then
								fxOrig[d] = "Visible"
								d.Visible = false
							elseif d:IsA("ScreenGui") and d.Enabled and d ~= gui then
								fxOrig[d] = "Enabled"
								d.Enabled = false
							end
						end
					end
				end
				for _, e in ipairs(Lighting:GetChildren()) do
					if (e:IsA("BlurEffect") or e:IsA("ColorCorrectionEffect") or e:IsA("BloomEffect") or e:IsA("SunRaysEffect"))
						and e.Enabled and listHas(S.fxNames, e.Name) then
						fxOrig[e] = "Enabled"
						e.Enabled = false
					end
				end
			end
		end
	end)

	------------------------------------------------------------ ESP kategorileri + renkler
	addSection(pVis, "ESP kategorileri")
	for _, c in ipairs({
		{ "espObj", "objWords", "Hedefler (Objectives)", "Hedef:" },
		{ "espCur", "curWords", "Para / Currency", "Para:" },
		{ "espLad", "ladWords", "Merdivenler", "Merdiven:" },
		{ "espMisc", "miscWords", "Diğer (Misc)", "Diğer:" },
	}) do
		addToggle(pVis, c[3], false, function(v)
			S[c[1]] = v
			clearEntities()
			X.refreshEnt()
		end, c[1])
		addTextBox(pVis, c[4], S[c[2]], function(t)
			S[c[2]] = t
			clearEntities()
			X.refreshEnt()
		end, c[2])
	end
	addSection(pVis, "ESP renkleri (tıkla, değişir)")
	for _, c in ipairs({
		{ "entity", "Varlıklar" }, { "door", "Kapılar" }, { "hide", "Saklanma yerleri" }, { "player", "Oyuncular" },
		{ "chest", "Sandıklar" }, { "item", "Eşyalar" }, { "currency", "Para" }, { "ladder", "Merdivenler" },
		{ "objective", "Hedefler" }, { "misc", "Diğer" },
	}) do
		local cat, label = c[1], c[2]
		local btn
		local function paint()
			if btn then
