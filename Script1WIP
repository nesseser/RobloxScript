	-- sonraki kapiya isinlan (kameranin baktigi yondeki en yakin gercek kapi)
	local function tpNextDoor()
		local root, cam = getRoot(), workspace.CurrentCamera
		if not (root and cam) then return false end
		local best, bd
		for _, o in pairs(ents) do
			if o.cat == "door" and not o.fake and o.part and o.part:IsDescendantOf(workspace) then
				local v = o.part.Position - root.Position
				local d = v.Magnitude
				if d > 8 and d < 400 and v.Unit:Dot(cam.CFrame.LookVector) > 0.2 and (not bd or d < bd) then
					best, bd = o, d
				end
			end
		end
		if not best then return false end
		local away = (root.Position - best.part.Position) * Vector3.new(1, 0, 1)
		away = away.Magnitude > 0.1 and away.Unit or Vector3.zAxis
		teleportTo(CFrame.new(best.part.Position + away * 4 + Vector3.new(0, 3, 0)))
		return true
	end
	addButton(pSet, "🚪  Sonraki kapıya ışınlan", function()
		if not tpNextDoor() then notify("Önünde uygun kapı yok (Kapıları göster açık mı?)", "warn") end
	end)
	addToggle(pSet, "Otomatik sonraki kapıya ışınlan", false, function(v) S.autoTpDoor = v end, "autoTpDoor")
	task.spawn(function()
		while true do
			task.wait(2)
			if S.autoTpDoor then pcall(tpNextDoor) end
		end
	end)

	-- varligi izle
	addToggle(pSet, "Varlığı izle (kamera en yakın varlıkta)", false, function(v)
		S.spectate = v
		if not v then
			local h = getHum()
			if h then workspace.CurrentCamera.CameraSubject = h end
		end
	end, "spectate")
	task.spawn(function()
		while true do
			task.wait(0.4)
			if S.spectate then
				local root, best, bd = getRoot(), nil, nil
				for _, o in pairs(ents) do
					if o.cat == "entity" and o.part and o.part:IsDescendantOf(workspace) and root then
						local d = (o.part.Position - root.Position).Magnitude
						if not bd or d < bd then best, bd = o, d end
					end
				end
				if best then workspace.CurrentCamera.CameraSubject = best.part end
			end
		end
	end)

	-- otomatik dolap: varlik yaklasinca en yakin saklanma prompt'unu tetikle
	addToggle(pSet, "Otomatik dolap (varlık yaklaşınca saklan)", false, function(v) S.autoCloset = v end, "autoCloset")
	addSlider(pSet, "Dolap tetik mesafesi", 10, 150, S.closetDist, function(v) S.closetDist = v end, 5, "closetDist")
	task.spawn(function()
		local cool = 0
		while true do
			task.wait(0.3)
			local root = S.autoCloset and getRoot()
			if root and os.clock() > cool then
				local threat = false
				for _, o in pairs(ents) do
					if o.cat == "entity" and o.dist and o.dist < S.closetDist then threat = true break end
				end
				if threat and X.prompts then
					local best, bd
					for p in pairs(X.prompts) do
						local part = p.Parent and p.Enabled and (p.Parent:IsA("Attachment") and p.Parent.Parent or p.Parent)
						if part and part:IsA("BasePart") then
							local text = p.ActionText .. " " .. p.ObjectText .. " " .. part.Name .. " " .. (part.Parent and part.Parent.Name or "")
							if listHas("hide,closet,wardrobe,locker,cabinet,dolap", text) then
								local d = (part.Position - root.Position).Magnitude
								if d < 60 and (not bd or d < bd) then best, bd = p, d end
							end
						end
					end
					if best then
						cool = os.clock() + 6
						local part = best.Parent:IsA("Attachment") and best.Parent.Parent or best.Parent
						if bd > best.MaxActivationDistance * 0.8 then
							teleportTo(CFrame.new(part.Position + Vector3.new(0, 3, 3)))
							task.wait(0.1)
						end
						pcall(function()
							if typeof(fireproximityprompt) == "function" then
								fireproximityprompt(best)
							else
								local h = best.HoldDuration
								best.HoldDuration = 0
								best:InputHoldBegin()
								task.wait(0.05)
								best:InputHoldEnd()
								best.HoldDuration = h
							end
						end)
						notify("Otomatik dolap: saklanıldı", "ok")
					end
				end
			end
		end
	end)
end

-- KAZAN / BITIS: finish ve checkpoint'lere isinlan (obby / yarisma tarzi oyunlar icin)
do
	local SKIP = "mesh,decal,frame,part,effect,particle"
	local cache, cacheT = nil, 0

	local function partOf(inst)
		if inst:IsA("BasePart") then return inst end
		if inst:IsA("Model") then return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true) end
	end
	-- listedeki isimlerden birini iceren model / part'lari bul (ust modeli de eslesiyorsa sadece en disi)
	local function find(words)
		local set = {}
		local n = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			if (d:IsA("Model") or d:IsA("BasePart")) and listHas(words, d.Name) and not listHas(SKIP, d.Name)
				and not Players:GetPlayerFromCharacter(d:FindFirstAncestorOfClass("Model")) then
				set[d] = true
			end
			n += 1
			if n % 2000 == 0 then task.wait() end
		end
		local list = {}
		for inst in pairs(set) do
			local a, nested = inst.Parent, false
			while a and a ~= workspace do
				if set[a] then nested = true break end
				a = a.Parent
			end
			local part = not nested and partOf(inst)
			if part then table.insert(list, { inst = inst, part = part }) end
		end
		return list
	end

	local function touchPart(part)
		local root = getRoot()
		if root and typeof(firetouchinterest) == "function" then
			pcall(function()
				firetouchinterest(root, part, 0)
				firetouchinterest(root, part, 1)
			end)
		end
	end
	local function goTo(part)
		teleportTo(CFrame.new(part.Position + Vector3.new(0, 3, 0)))
		task.wait(0.1)
		touchPart(part)
	end

	-- bitis: baslangic noktasindan EN UZAK eslesen parca
	local function finishPart(force)
		if force or not cache or os.clock() - cacheT > 15 then
			cache, cacheT = find(S.winNames), os.clock()
		end
		local spawn = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
		local root = getRoot()
		local from = spawn and spawn.Position or (root and root.Position)
		if not from then return nil end
		local best, bd
		for _, e in ipairs(cache) do
			if e.part.Parent then
				local d = (e.part.Position - from).Magnitude
				if not bd or d > bd then best, bd = e, d end
			end
		end
		return best
	end

	addSection(pTp, "Kazan / Bitiş (obby, yarışma)")
	addTextBox(pTp, "Bitiş adı:", S.winNames, function(t) S.winNames = t; cache = nil end, "winNames")
	addButton(pTp, "🏁  Bitişe ışınlan", function()
		task.spawn(function()
			local f = finishPart(true)
			if f then
				goTo(f.part)
				notify("Bitişe ışınlandın: " .. f.inst.Name, "ok")
			else
				notify("Bitiş bulunamadı (adlar: " .. S.winNames .. ")", "warn")
			end
		end)
	end, "accent")

	addTextBox(pTp, "Checkpoint adı:", S.cpNames, function(t) S.cpNames = t end, "cpNames")
	addSlider(pTp, "Noktalar arası bekleme (sn)", 0, 2, S.winDelay, function(v) S.winDelay = v end, 0.1, "winDelay")
	local running = false
	addButton(pTp, "✅  Checkpoint'leri sırayla gez, sonra bitişe git", function()
		if running then return end
		running = true
		task.spawn(function()
			local list = find(S.cpNames)
			table.sort(list, function(a, b)
				local na, nb = tonumber(a.inst.Name:match("%d+")), tonumber(b.inst.Name:match("%d+"))
				if na and nb and na ~= nb then return na < nb end
				return a.inst.Name < b.inst.Name
			end)
			X.hold = true
			for i, e in ipairs(list) do
				if not getRoot() then break end
				if e.part.Parent then
					goTo(e.part)
					notify("Checkpoint " .. i .. "/" .. #list .. ": " .. e.inst.Name, "info", "cp")
					task.wait(S.winDelay)
				end
			end
			local f = finishPart(true)
			if f and getRoot() then goTo(f.part) end
			if not X.dodging then X.hold = false end
			notify(f and "Bitti, bitişe gidildi" or ("Bitiş bulunamadı, " .. #list .. " checkpoint gezildi"), f and "ok" or "warn")
			running = false
		end)
	end)

	addToggle(pTp, "Otomatik kazan (bitişte değilsen ışınlan)", false, function(v) S.autoWin = v end, "autoWin")
	addSlider(pTp, "Otomatik kazan aralığı (sn)", 2, 30, S.autoWinEvery, function(v) S.autoWinEvery = v end, 1, "autoWinEvery")
	task.spawn(function()
		while true do
			task.wait(S.autoWinEvery)
			if S.autoWin and getRoot() then
				pcall(function()
					local f = finishPart(false)
					local root = getRoot()
					if f and root and (f.part.Position - root.Position).Magnitude > 30 then goTo(f.part) end
				end)
			end
		end
	end)
end

-- PARA TOPLAMA: coin / gold modellerini teker teker isinlanarak topla
do
	local running = false

	local function scan(origin)
		local set = {}
		local n = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			if (d:IsA("Model") or d:IsA("BasePart")) and listHas(S.coinNames, d.Name) and not ignored(d.Name) then
				set[d] = true
			end
			n += 1
			if n % 2000 == 0 then task.wait() end
		end
		local list = {}
		for inst in pairs(set) do
			-- ust modeli de eslesiyorsa sadece en disini al
			local a, nested = inst.Parent, false
			while a and a ~= workspace do
				if set[a] then nested = true break end
				a = a.Parent
			end
			if not nested then
				local part = inst:IsA("BasePart") and inst or (inst:IsA("Model") and (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart", true)))
				if part and (part.Position - origin).Magnitude <= math.min(S.coinRange, 600) then
					table.insert(list, { inst = inst, part = part })
				end
			end
		end
		return list
	end

	local function grab(e)
		local root = getRoot()
		if root and typeof(firetouchinterest) == "function" then
			pcall(function()
				firetouchinterest(root, e.part, 0)
				firetouchinterest(root, e.part, 1)
			end)
		end
		local pp = e.inst:FindFirstChildWhichIsA("ProximityPrompt", true)
		if pp then
			pcall(function()
				if typeof(fireproximityprompt) == "function" then
					fireproximityprompt(pp)
				else
					local h = pp.HoldDuration
					pp.HoldDuration = 0
					pp:InputHoldBegin()
					task.wait(0.05)
					pp:InputHoldEnd()
					pp.HoldDuration = h
				end
			end)
		end
		local cd = e.inst:FindFirstChildWhichIsA("ClickDetector", true)
		if cd and typeof(fireclickdetector) == "function" then pcall(fireclickdetector, cd) end
	end

	local startBtn
	local function paint()
		if startBtn then startBtn.Text = S.coinRun and "⏹  Para toplamayı durdur" or "💰  Para topla (teker teker ışınlan)" end
	end

	local function run()
		if running then return end
		local root = getRoot()
		if not root then return end
		running = true
		S.coinRun = true
		paint()
		task.spawn(function()
			local origin = root.CFrame
			notify("Para taranıyor...", "info")
			local list = scan(origin.Position)
			if #list == 0 then
				notify("Para bulunamadı (adlar: " .. S.coinNames .. ")", "warn")
			else
				X.hold = true
				local pos, n = origin.Position, 0
				while #list > 0 and S.coinRun and getRoot() do
					local bi, bd
					for i = #list, 1, -1 do
						local e = list[i]
						if not (e.inst.Parent and e.part.Parent) then
							table.remove(list, i)
						else
							local d = (e.part.Position - pos).Magnitude
							if not bd or d < bd then bi, bd = i, d end
						end
					end
					if not bi then break end
					local e = table.remove(list, bi)
					teleportTo(CFrame.new(e.part.Position + Vector3.new(0, 2, 0)))
					task.wait(0.05)
					grab(e)
					pos = e.part.Position
					n += 1
					task.wait(S.coinDelay)
				end
				if S.coinReturn and getRoot() then teleportTo(origin) end
				if not X.dodging then X.hold = false end
				notify("Para toplama bitti: " .. n .. " nesne", "ok")
			end
			running = false
			S.coinRun = false
			paint()
		end)
	end

	addSection(pItem, "Para / coin toplama (ışınlanarak)")
	startBtn = addButton(pItem, "", function()
		if running then S.coinRun = false else run() end
	end, "accent")
	paint()
	addTextBox(pItem, "Para adı:", S.coinNames, function(t) S.coinNames = t end, "coinNames")
	addSlider(pItem, "Işınlanmalar arası bekleme (sn)", 0, 1, S.coinDelay, function(v) S.coinDelay = v end, 0.05, "coinDelay")
	addSlider(pItem, "Tarama menzili (stud)", 50, 600, S.coinRange, function(v) S.coinRange = v end, 10, "coinRange")
	addToggle(pItem, "Bitince eski yere dön", true, function(v) S.coinReturn = v end, "coinReturn")
end

-- KAPILAR: gercek / sahte ayri listelenir (isimler ve yollar workspace'teki gibi)
do
	local filter, sig = "", ""
	addSection(pDoor, "Kapı listesi (workspace'teki adlarıyla)")
	addTextBox(pDoor, "Ara:", "", function(t) filter = t; sig = "" end)
	addTextBox(pDoor, "Sahte kelimeler:", S.fakeWords, function(t)
		S.fakeWords = t
		clearEntities()
		X.refreshEnt()
		sig = ""
	end, "fakeWords")
	local info = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, TextWrapped = true, TextColor3 = T.sub,
		Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, Text = "",
	}, pDoor)

	local function makeGroup(color)
		local hdr = new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, TextColor3 = color, Font = Enum.Font.GothamBold,
			TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Text = "", NoBind = true,
		}, pDoor)
		local box = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, pDoor)
		new("UIListLayout", { Padding = UDim.new(0, 5) }, box)
		return hdr, box
	end
	local realHdr, realBox = makeGroup(T.info)
	local fakeHdr, fakeBox = makeGroup(T.bad)
	local distLbls = {}

	local function fill(box, list, color)
		for _, c in ipairs(box:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		for i = 1, math.min(#list, 40) do
			local e = list[i]
			local r = row(box, 42)
			new("Frame", { Size = UDim2.fromOffset(4, 30), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = color, BorderSizePixel = 0, NoBind = true }, r)
			new("TextLabel", {
				Size = UDim2.new(1, -90, 0, 18), Position = UDim2.fromOffset(16, 3), BackgroundTransparency = 1, Text = e.inst.Name,
				TextColor3 = T.text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			}, r)
			distLbls[e.inst] = new("TextLabel", {
				Size = UDim2.new(1, -90, 0, 14), Position = UDim2.fromOffset(16, 23), BackgroundTransparency = 1,
				Text = e.inst:GetFullName(), TextColor3 = T.sub, Font = Enum.Font.Gotham, TextSize = 10,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			}, r)
			miniBtn(r, "Git", -60, function()
				local o, root = ents[e.inst], getRoot()
				if o and o.part and root then
					local away = (root.Position - o.part.Position) * Vector3.new(1, 0, 1)
					away = away.Magnitude > 0.1 and away.Unit or Vector3.zAxis
					teleportTo(CFrame.new(o.part.Position + away * 4 + Vector3.new(0, 3, 0)))
				end
			end)
		end
	end

	local function refresh()
		if not S.entDoor then
			info.Text = "  Kapı izleme kapalı (Görsel → Kapıları göster)"
		else
			info.Text = "  Kırmızı = adında sahte kelimesi geçenler. Tüm kapılar listelenir (ekrandaki etiketler 600 stud ile sınırlı)."
		end
		local root = getRoot()
		local real, fake, f = {}, {}, filter:lower()
		for inst, o in pairs(ents) do
			if o.cat == "door" and o.part then
				local full = inst:GetFullName()
				if f == "" or full:lower():find(f, 1, true) then
					table.insert(o.fake and fake or real, { inst = inst, d = root and (o.part.Position - root.Position).Magnitude or 0, full = full })
				end
			end
		end
		table.sort(real, function(a, b) return a.d < b.d end)
		table.sort(fake, function(a, b) return a.d < b.d end)
		local parts = {}
		for i = 1, math.min(#real, 40) do parts[#parts + 1] = real[i].full end
		parts[#parts + 1] = "||"
		for i = 1, math.min(#fake, 40) do parts[#parts + 1] = fake[i].full end
		local newSig = table.concat(parts, "|")
		realHdr.Text = "  GERÇEK KAPILAR (" .. #real .. ")"
		fakeHdr.Text = "  SAHTE KAPILAR (" .. #fake .. ")"
		if newSig ~= sig then
			sig = newSig
			table.clear(distLbls)
			fill(realBox, real, T.info)
			fill(fakeBox, fake, T.bad)
		end
		if root then
			for inst, lbl in pairs(distLbls) do
				local o = ents[inst]
				if o and o.part then
					lbl.Text = math.floor((o.part.Position - root.Position).Magnitude + 0.5) .. " stud  •  " .. inst:GetFullName()
				end
			end
		end
	end
	task.spawn(function()
		while true do
			task.wait(1)
			if main.Visible and pDoor.Visible then pcall(refresh) end
		end
	end)
end

-- DEPO: istemcinin gorebildigi yerlerdeki Tool'lari listele, kendine ver (sadece yerel)
do
	local StarterPack = game:GetService("StarterPack")
	local roots = {
		ReplicatedStorage, StarterPack, workspace, Lighting,
		game:GetService("ReplicatedFirst"), game:GetService("StarterGui"),
	}
	local found, filter, scanning = {}, "", false

	local function give(tool)
		local bp = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 3)
		if not bp then notify("Backpack bulunamadı", "bad") return end
		local ok, clone = pcall(function() return tool:Clone() end)
		if not ok or not clone then notify("Kopyalanamadı: " .. tool.Name, "bad") return end
		clone.Parent = bp
		notify(tool.Name .. " çantana eklendi (sadece yerel)", "ok")
	end

	addSection(pDepo, "Tool deposu")
	local info = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, TextWrapped = true, TextColor3 = T.sub,
		Font = Enum.Font.Gotham, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
	}, pDepo)
	local listBox = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, pDepo)
	new("UIListLayout", { Padding = UDim.new(0, 5) }, listBox)

	local function rebuild()
		for _, c in ipairs(listBox:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		local f, n = filter:lower(), 0
		for _, t in ipairs(found) do
			if t.Parent and (f == "" or t.Name:lower():find(f, 1, true)) then
				n += 1
				if n > 40 then break end
				local r = row(listBox, 40)
				new("TextLabel", {
					Size = UDim2.new(1, -76, 0, 18), Position = UDim2.fromOffset(10, 3), BackgroundTransparency = 1, Text = t.Name,
					TextColor3 = T.text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}, r)
				new("TextLabel", {
					Size = UDim2.new(1, -76, 0, 14), Position = UDim2.fromOffset(10, 21), BackgroundTransparency = 1, Text = t:GetFullName(),
					TextColor3 = T.sub, Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}, r)
				miniBtn(r, "Ver", -60, function() give(t) end)
			end
		end
		local ss = #game:GetService("ServerStorage"):GetChildren()
		info.Text = string.format("%d tool bulundu (en fazla 40 listelenir).\nServerStorage istemciye hiç gönderilmez, burada görünmez (şu an %d öğe).", #found, ss)
	end

	local function scan()
		if scanning then return end
		scanning = true
		task.spawn(function()
			table.clear(found)
			local n = 0
			for _, r in ipairs(roots) do
				for _, d in ipairs(r:GetDescendants()) do
					if (d:IsA("Tool") or d:IsA("HopperBin")) and not (d.Parent and d.Parent:FindFirstChildOfClass("Humanoid")) then
						table.insert(found, d)
					end
					n += 1
					if n % 2000 == 0 then task.wait() end
				end
			end
			scanning = false
			rebuild()
		end)
	end

	addButton(pDepo, "🔄  Tara (ReplicatedStorage, StarterPack, Workspace...)", scan, "accent")
	addTextBox(pDepo, "Ara:", "", function(t) filter = t; rebuild() end)
	addTextBox(pDepo, "Ada göre ver:", "", function(t)
		local q = t:lower()
		if q == "" then return end
		for _, tool in ipairs(found) do
			if tool.Parent and tool.Name:lower():find(q, 1, true) then give(tool) return end
		end
		notify("'" .. t .. "' adında tool bulunamadı, önce Tara", "warn")
	end)

	addSection(pDepo, "ReplicatedStorage içeriği")
	local rsBox = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, TextWrapped = true,
		TextColor3 = T.sub, Font = Enum.Font.Code, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top, Text = "",
	}, pDepo)
	addButton(pDepo, "📋  İçeriği listele", function()
		local lines = {}
		for i, c in ipairs(ReplicatedStorage:GetChildren()) do
			if i > 60 then lines[#lines + 1] = "..."; break end
			lines[#lines + 1] = c.ClassName .. "  " .. c.Name
		end
		rsBox.Text = #lines > 0 and table.concat(lines, "\n") or "(boş)"
	end)

	task.delay(3, scan)
end

-- ESYA LISTESI + OTOMATIK TOPLAMA
do
	local PathfindingService = game:GetService("PathfindingService")
	local tried = {}
	local running = false

	local function itemPos(o) return o.part.Position end

	local function nearestItem()
		local root = getRoot()
		if not root then return nil end
		local best, bd
		for inst, o in pairs(ents) do
			if (o.cat == "item" or (o.cat == "chest" and S.collectChest)) and o.part and o.part:IsDescendantOf(workspace)
				and (not tried[inst] or os.clock() - tried[inst] > 30) then
				local d = (itemPos(o) - root.Position).Magnitude
				if d <= math.min(S.collectMax, 600) and (not bd or d < bd) then best, bd = inst, d end
			end
		end
		return best
	end

	-- noktadan noktaya git: Işınlan = aninda, Yürü = collectSpeed hizinda
	local function moveTo(pos)
		if S.collectMode == "Işınlan" then
			if not getRoot() then return false end
			teleportTo(CFrame.new(pos))
			return true
		end
		-- dogal yuruyus: yol bul + Humanoid:MoveTo (fizik / anti-cheat ile kavga etmez)
		local function active() return S.autoCollect or S.collectManual end
		local function dist2()
			local r = getRoot()
			return r and (r.Position - pos).Magnitude or math.huge
		end
		local hum = getHum()
		if not hum then return false end
		local oldWS = hum.WalkSpeed
		if not S.speedOn then hum.WalkSpeed = S.collectSpeed end
		local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
		local root = getRoot()
		local ok = root and pcall(function() path:ComputeAsync(root.Position, pos) end)
		if ok and path.Status == Enum.PathStatus.Success then
			for _, wp in ipairs(path:GetWaypoints()) do
				if not active() or dist2() < 5 then break end
				if wp.Action == Enum.PathWaypointAction.Jump then hum.Jump = true end
				hum:MoveTo(wp.Position)
				local t0 = os.clock()
				local r
				repeat
					task.wait(0.05)
					r = getRoot()
				until not active() or not r or (r.Position - wp.Position).Magnitude < 4 or os.clock() - t0 > 2.5
			end
		end
		-- yol bulunamadiysa dogrudan yuru
		local t1 = os.clock()
		while active() and dist2() > 4 and os.clock() - t1 < 5 do
			hum:MoveTo(pos)
			task.wait(0.1)
		end
		if not S.speedOn and hum.Parent then hum.WalkSpeed = oldWS end
		return dist2() <= 8
	end

	local function pickup(inst, o)
		local root = getRoot()
		if root and typeof(firetouchinterest) == "function" then
			pcall(function()
				firetouchinterest(root, o.part, 0)
				firetouchinterest(root, o.part, 1)
			end)
		end
		local pp = inst:FindFirstChildWhichIsA("ProximityPrompt", true)
		if pp then
			pcall(function()
				if typeof(fireproximityprompt) == "function" then
					fireproximityprompt(pp)
				else
					pp:InputHoldBegin()
					task.wait(pp.HoldDuration + 0.1)
					pp:InputHoldEnd()
				end
			end)
		end
		local cd = inst:FindFirstChildWhichIsA("ClickDetector", true)
		if cd and typeof(fireclickdetector) == "function" then pcall(fireclickdetector, cd) end
	end

	local function collectOne(inst)
		local o = ents[inst]
		if not o or not o.part then return end
		tried[inst] = os.clock()
		S.collectManual = true
		if moveTo(itemPos(o)) then
			pickup(inst, o)
			if not inst:FindFirstChildWhichIsA("ProximityPrompt", true) and not inst:FindFirstChildWhichIsA("ClickDetector", true)
				and typeof(firetouchinterest) ~= "function" then
				notify("'" .. inst.Name .. "' için prompt / ClickDetector yok (dokunmayla toplanıyor olabilir)", "warn")
			end
		else
			notify("'" .. inst.Name .. "' konumuna ulaşılamadı", "warn")
		end
		S.collectManual = false
	end

	-- haritadaki tum ProximityPrompt'lar (bir kez taranir, sonra olay ile guncellenir)
	local prompts = {}
	X.prompts = prompts
	task.spawn(function()
		local n = 0
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt") then prompts[d] = true end
			n += 1
			if n % 2000 == 0 then task.wait() end
		end
	end)
	X.onAdded(function(d)
		if d:IsA("ProximityPrompt") then prompts[d] = true end
	end)
	workspace.DescendantRemoving:Connect(function(d) prompts[d] = nil end)
	local function promptPart(p)
		local part = p.Parent
		if part and part:IsA("Attachment") then part = part.Parent end
		if part and part:IsA("BasePart") then return part end
	end

	-- R: yakindaki tum prompt'lari (cekmece, esya, anahtarli kapi...) hizlica tetikle
	local function firePrompt(p)
		if typeof(fireproximityprompt) == "function" then
			fireproximityprompt(p)
		else
			local hold = p.HoldDuration
			p.HoldDuration = 0
			p:InputHoldBegin()
			task.wait(0.05)
			p:InputHoldEnd()
			p.HoldDuration = hold
		end
	end
	local function underDoor(inst)
		local a = inst
		while a and a ~= workspace do
			if listHas(S.entDoors, a.Name) and not listHas("frame", a.Name) then return true end
			a = a.Parent
		end
		return false
	end
	local quickBusy = false
	function X.quick()
		local root = getRoot()
		if quickBusy or not root then return end
		quickBusy = true
		task.spawn(function()
			local origin = root.CFrame
			X.hold = true -- isinlanirken fizik firlatmasin
			local targets = {}
			for d in pairs(prompts) do
				if d.Parent and d.Enabled then
					local part = promptPart(d)
					if part then
						local dist = (part.Position - origin.Position).Magnitude
						if dist <= S.rRange then
							local isDoor = underDoor(part)
							if (isDoor and S.rDoors) or (not isDoor and S.rItems) then
								table.insert(targets, { p = d, part = part, dist = dist })
							end
						end
					end
				end
			end
			table.sort(targets, function(a, b) return a.dist < b.dist end)
			local n = 0
			for _, t in ipairs(targets) do
				local r = getRoot()
				if not r then break end
				if t.part.Parent and t.p.Parent then
					if (t.part.Position - r.Position).Magnitude > math.max(4, t.p.MaxActivationDistance * 0.7) then
						-- parcanin icine degil, ona dogru bakan tarafina dur
						local away = (origin.Position - t.part.Position) * Vector3.new(1, 0, 1)
						away = away.Magnitude > 0.1 and away.Unit or Vector3.zAxis
						teleportTo(CFrame.new(t.part.Position + away * 3 + Vector3.new(0, 2, 0)))
						task.wait(0.08)
					end
					pcall(firePrompt, t.p)
					n += 1
					task.wait(S.rDelay)
				end
			end
			if S.rReturn and getRoot() then teleportTo(origin) end
			if not X.dodging then X.hold = false end
			notify(n > 0 and ("R: " .. n .. " etkileşim yapıldı") or "R: yakında etkileşim yok", n > 0 and "ok" or "warn")
			quickBusy = false
		end)
	end

	-- surekli mod: ISINLANMADAN, sadece prompt menzilindeki esya/cekmeceleri tetikler
	local function isLoot(p, part)
		local m = part:FindFirstAncestorOfClass("Model")
		local text = p.ActionText .. " " .. p.ObjectText .. " " .. part.Name .. " " .. (m and m.Name or "")
		if listHas(S.nearSkip, text) then return false end
		return listHas(S.lootWords, text) or listHas(S.entItems, text) or listHas(S.entChests, text)
	end
	task.spawn(function()
		local cool = setmetatable({}, { __mode = "k" })
		while true do
			task.wait(S.nearInterval)
			local root = S.nearAuto and not quickBusy and getRoot()
			if root then
				local char = getChar()
				for p in pairs(prompts) do
					if not S.nearAuto then break end
					local part = p.Parent and p.Enabled and promptPart(p)
					if part and (not cool[p] or os.clock() - cool[p] > 3)
						and not (char and part:IsDescendantOf(char)) and not p:FindFirstAncestorOfClass("Tool") then
						if (part.Position - root.Position).Magnitude <= p.MaxActivationDistance then
							local isDoor = underDoor(part)
							if (isDoor and S.nearDoors) or (not isDoor and S.nearItems and isLoot(p, part)) then
								cool[p] = os.clock()
								pcall(firePrompt, p)
								task.wait(S.rDelay)
							end
						end
					end
				end
			end
		end
	end)

	function X.startCollect()
		if running then return end
		running = true
		table.clear(tried)
		task.spawn(function()
			while S.autoCollect do
				local inst = nearestItem()
				if inst then
					collectOne(inst)
					task.wait(S.collectDelay)
				else
					task.wait(0.5)
				end
			end
			running = false
		end)
	end

	addSection(pItem, "Eşya takibi")
	addToggle(pItem, "Eşyaları izle (listele)", false, function(v)
		S.entItem = v
		X.refreshEnt()
	end, "entItem")
	addTextBox(pItem, "Eşya adı:", S.entItems, function(t) S.entItems = t; X.refreshEnt() end, "entItems")
	addToggle(pItem, "Sandık / kasa gibi şeyleri izle", false, function(v)
		S.entChest = v
		X.refreshEnt()
	end, "entChest")
	addTextBox(pItem, "Sandık adı:", S.entChests, function(t) S.entChests = t; X.refreshEnt() end, "entChests")
	addSection(pItem, "Otomatik toplama")
	addToggle(pItem, "Toplarken sandıkları da aç", true, function(v) S.collectChest = v end, "collectChest")
	addToggle(pItem, "Otomatik topla (en yakından başla)", false, function(v)
		S.autoCollect = v
		if v then
			if not S.entItem then
				registry.entItem.set(true)
				registry.entItem.cb(true)
			end
			if S.collectChest and not S.entChest then
				registry.entChest.set(true)
				registry.entChest.cb(true)
			end
			notify("Otomatik toplama başladı", "ok")
			X.startCollect()
		end
	end, "autoCollect")
	do
		local modes = { "Yürü", "Işınlan" }
		local modeBtn
		local function setMode(m)
			S.collectMode = m
			if modeBtn then modeBtn.Text = "Gidiş: " .. m .. "  (tıkla değiştir)" end
		end
		modeBtn = addButton(pItem, "", function()
			setMode(modes[((table.find(modes, S.collectMode) or 1) % #modes) + 1])
			markDirty()
		end)
		setMode(S.collectMode)
		registry.collectMode = { default = "Yürü", cb = function() end, get = function() return S.collectMode end, set = setMode }
	end
	addSlider(pItem, "Yürüme hızı (WalkSpeed)", 10, 300, S.collectSpeed, function(v) S.collectSpeed = v end, 5, "collectSpeed")
	addSlider(pItem, "Eşyalar arası bekleme (sn)", 0, 3, S.collectDelay, function(v) S.collectDelay = v end, 0.1, "collectDelay")
	addSlider(pItem, "Max toplama mesafesi", 50, 600, S.collectMax, function(v) S.collectMax = v end, 50, "collectMax")

	addSection(pItem, "Yakındakileri sürekli topla (ışınlanmadan)")
	addToggle(pItem, "Sürekli otomatik topla (çekmece / eşya)", false, function(v) S.nearAuto = v end, "nearAuto")
	addToggle(pItem, "Eşya / çekmeceleri topla", true, function(v) S.nearItems = v end, "nearItems")
	addToggle(pItem, "Kapıları da aç", false, function(v) S.nearDoors = v end, "nearDoors")
	addSlider(pItem, "Tarama aralığı (sn)", 0.2, 3, S.nearInterval, function(v) S.nearInterval = v end, 0.1, "nearInterval")
	addTextBox(pItem, "Toplanır:", S.lootWords, function(t) S.lootWords = t end, "lootWords")
	addTextBox(pItem, "Atla:", S.nearSkip, function(t) S.nearSkip = t end, "nearSkip")
	addSection(pItem, "R tuşu: hızlı topla / aç")
	addToggle(pItem, "R ile yakındakileri tetikle", true, function(v) S.rQuick = v end, "rQuick")
	addToggle(pItem, "Çekmece / eşya / sandık", true, function(v) S.rItems = v end, "rItems")
	addToggle(pItem, "Kapılar (anahtarlı dahil)", true, function(v) S.rDoors = v end, "rDoors")
	addToggle(pItem, "İş bitince eski yere dön", true, function(v) S.rReturn = v end, "rReturn")
	addSlider(pItem, "R menzili (stud)", 10, 200, S.rRange, function(v) S.rRange = v end, 5, "rRange")
	addSlider(pItem, "İşlemler arası bekleme (sn)", 0, 1, S.rDelay, function(v) S.rDelay = v end, 0.05, "rDelay")

	addSection(pItem, "Bulunan eşyalar")
	local countLbl = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "", TextColor3 = T.sub,
		Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
	}, pItem)
	local listBox = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, pItem)
	new("UIListLayout", { Padding = UDim.new(0, 5) }, listBox)

	local shown, sig = {}, ""
	local function refreshList(force)
		local root = getRoot()
		local arr = {}
		for inst, o in pairs(ents) do
			if (o.cat == "item" or o.cat == "chest") and o.part then
				local d = root and (itemPos(o) - root.Position).Magnitude or 0
				if d <= 600 then table.insert(arr, { inst = inst, d = d }) end
			end
		end
		table.sort(arr, function(a, b) return a.d < b.d end)
		countLbl.Text = "  " .. #arr .. " eşya bulundu (en yakın 25 listelenir)"
		local s = {}
		for i = 1, math.min(#arr, 25) do s[i] = arr[i].inst:GetFullName() end
		local newSig = table.concat(s, "|")
		if force or newSig ~= sig then
			sig = newSig
			for _, c in ipairs(listBox:GetChildren()) do
				if c:IsA("Frame") then c:Destroy() end
			end
			table.clear(shown)
			for i = 1, math.min(#arr, 25) do
				local inst = arr[i].inst
				local r = row(listBox, 36)
				local lbl = new("TextLabel", {
					Size = UDim2.new(1, -130, 1, 0), Position = UDim2.fromOffset(12, 0), BackgroundTransparency = 1,
					Text = inst.Name, TextColor3 = T.text, Font = Enum.Font.GothamMedium, TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				}, r)
				shown[i] = { inst = inst, lbl = lbl }
				miniBtn(r, "Git", -118, function()
					local o = ents[inst]
					if o and o.part then teleportTo(CFrame.new(itemPos(o) + Vector3.new(0, 3, 0))) end
				end)
				miniBtn(r, "Al", -60, function() task.spawn(collectOne, inst) end)
			end
		end
		for _, e in ipairs(shown) do
			local o = ents[e.inst]
			if o and o.part and root then
				e.lbl.Text = e.inst.Name .. "  " .. math.floor((itemPos(o) - root.Position).Magnitude + 0.5) .. " stud"
			end
		end
	end
	addButton(pItem, "🔄  Listeyi yenile", function() X.refreshEnt(); task.delay(0.6, refreshList, true) end)
	task.spawn(function()
		while true do
			task.wait(1)
			if main.Visible and pItem.Visible then pcall(refreshList) end
		end
	end)
end

