	hum.Died:Connect(function()
		local r = char:FindFirstChild("HumanoidRootPart")
		if r then lastDeathCF = r.CFrame end
	end)
end

local function setupChar(char)
	camera = workspace.CurrentCamera
	flyBV, flyBG, safePos = nil, nil, nil
	X.lastPos, X.speeding, X.dodging, X.hold = nil, false, false, false
	task.spawn(hookDeath, char)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not root then return end
	if lastDeathCF and (pendingRevive or S.respawnAtDeath) then
		task.wait(0.15)
		char:PivotTo(lastDeathCF + Vector3.new(0, 3, 0))
		X.lastPos = nil
		if pendingRevive then notify("Öldüğün yerde yeniden doğdun", "ok") end
		pendingRevive = false
	end
	if S.flyOn then ensureFly() end
end
