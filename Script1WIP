	if logPaused or not logList then return end
	local e = new("TextLabel", {
		Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		Text = string.format("[%s] %s", os.date("%H:%M:%S"), tostring(text)),
		TextColor3 = logColor(kind), Font = Enum.Font.Code, TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Visible = logFilters[kind] ~= false,
	}, logList)
	e:SetAttribute("Kind", kind)
	table.insert(logEntries, e)
	if #logEntries > 300 then table.remove(logEntries, 1):Destroy() end
	task.defer(function() logList.CanvasPosition = Vector2.new(0, 1e6) end)
end

