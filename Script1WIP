-- KAYGAN ZEMIN + ANTI GERI-ATMA + DOKUNMA (Heartbeat'ten cagrilir)
do
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local floorOrig, slipChar, acc = {}, nil, 0
	local SLIP_PROPS = PhysicalProperties.new(0.7, 2, 0, 100, 100)
	local FLOOR_PROPS = PhysicalProperties.new(0.7, 1.5, 0, 100, 100)
	local lastNote = 0

	local function eachPart(c, fn)
		for _, p in ipairs(c:GetDescendants()) do
			if p:IsA("BasePart") then fn(p) end
		end
	end

	-- sadece oldurucu bloklarin dokunmasini kapat (kapi vb. etkilenmez)
	local killOrig = {}
	local dmgOrig, charOrig, lastFlee = {}, {}, 0
	local function isKill(p)
		if not p:IsA("BasePart") then return false end
		if listHas(S.killNames, p.Name) then return true end
		local par = p.Parent
		return par ~= nil and par:IsA("Model") and listHas(S.killNames, par.Name)
	end
	local function disableKill(p)
		if killOrig[p] == nil then
			killOrig[p] = p.CanTouch
			p.CanTouch = false
		end
	end
	local killScan = 0
	function X.refreshKill()
		killScan += 1
		local id = killScan
		for p, orig in pairs(killOrig) do
			if p.Parent then p.CanTouch = orig end
		end
		table.clear(killOrig)
		if not S.noTouch then return end
		task.spawn(function()
			local n = 0
			for _, d in ipairs(workspace:GetDescendants()) do
				if id ~= killScan then return end
				if isKill(d) then disableKill(d) end
				n += 1
				if n % 1500 == 0 then task.wait() end
			end
		end)
	end
	X.onAdded(function(d)
		if S.noTouch and isKill(d) then disableKill(d) end
	end)

	-- yaratik tam dokunacagi anin ~1 sn oncesinde karakteri uzaga firlat, yaratik gecince eski yere geri koy
	function X.dodgeAway()
		local root = getRoot()
		if X.dodging or not root then return end
		X.dodging = true
		local origin = root.CFrame
		task.spawn(function()
			X.hold = true
			teleportTo(origin + Vector3.new(0, S.dodgeFar, 0))
			notify("Yaratık yaklaştı, uzağa fırlatıldın", "warn")
			local t0 = os.clock()
			while os.clock() - t0 < 15 and getRoot() do
				task.wait(0.1)
				if os.clock() - t0 >= S.dodgeStay then
					local clear = true
					for _, o in pairs(ents) do
						if o.cat == "entity" and o.part and o.part:IsDescendantOf(workspace)
							and (o.part.Position - origin.Position).Magnitude < S.dodgeBack then
							clear = false
							break
						end
					end
					if clear then break end
				end
			end
			if getRoot() then teleportTo(origin) end
			X.hold = false
			X.dodging = false
		end)
	end

	-- "BAKINCA HASAR VEREN" yaratiklar (Eyes vb.): kamerayi yere cevir / yerelde gizle
	local lookOrig, lastLookNote = {}, 0
	local function isLook(inst) return listHas(S.lookNames, inst.Name) end
	local function hideObj(p)
		if lookOrig[p] then return end
		if p:IsA("BasePart") then
			lookOrig[p] = { p.Transparency, p.CanQuery }
			p.Transparency = 1
			p.CanQuery = false
		elseif p:IsA("Decal") or p:IsA("Texture") then
			lookOrig[p] = { p.Transparency }
			p.Transparency = 1
		elseif p:IsA("Light") or p:IsA("ParticleEmitter") then
			lookOrig[p] = { p.Enabled }
			p.Enabled = false
		end
	end
	function X.restoreLook()
		for p, v in pairs(lookOrig) do
			if p.Parent then
				if p:IsA("BasePart") then
					p.Transparency, p.CanQuery = v[1], v[2]
				elseif p:IsA("Decal") or p:IsA("Texture") then
					p.Transparency = v[1]
				else
					p.Enabled = v[1]
				end
			end
		end
		table.clear(lookOrig)
	end
	function X.hideLookers()
		for inst, o in pairs(ents) do
			if o.cat == "entity" and isLook(inst) and inst:IsDescendantOf(workspace) then
				hideObj(inst)
				for _, d in ipairs(inst:GetDescendants()) do hideObj(d) end
			end
		end
	end
	RunService:BindToRenderStep("HunterLookGuard", Enum.RenderPriority.Camera.Value + 1, function()
		if not S.lookGuard then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		for inst, o in pairs(ents) do
			if o.cat == "entity" and o.part and isLook(inst) and o.part:IsDescendantOf(workspace) then
				local pos = inst:IsA("Model") and inst:GetPivot().Position or o.part.Position
				local v, on = cam:WorldToViewportPoint(pos)
				if on and v.Z > 0 and v.Z < S.lookRange then
					local _, yaw = cam.CFrame:ToEulerAnglesYXZ()
					cam.CFrame = CFrame.new(cam.CFrame.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-math.rad(80), 0, 0)
					if os.clock() - lastLookNote > 3 then
						lastLookNote = os.clock()
						notify("'" .. inst.Name .. "' ekranda: kamera yere çevrildi", "warn")
					end
					break
				end
			end
		end
	end)

	function X.restoreEntDmg()
		for p in pairs(dmgOrig) do
			if p.Parent then p.CanTouch = true end
		end
		table.clear(dmgOrig)
		for p in pairs(charOrig) do
			if p.Parent then p.CanTouch = true end
		end
		table.clear(charOrig)
	end

	function X.restoreSlip()
		for part, orig in pairs(floorOrig) do
			if part.Parent then part.CustomPhysicalProperties = orig or nil end
		end
		table.clear(floorOrig)
		local c = getChar()
		if c then eachPart(c, function(p) p.CustomPhysicalProperties = nil end) end
		slipChar = nil
	end

	function X.update(dt, hum, root)
		-- isinlanma / kacis sirasinda fizik karakteri firlatmasin
		if X.hold then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
		-- sunucu bizi geri attiysa (tek karede buyuk sicrama) eski konuma dondur
		local pos = root.Position
		if S.antiRubber and (S.speedOn or S.flyOn) and X.lastPos and dt < 0.25 then
			local allowed = math.max(25, X.cur * dt * 3, S.flySpeed * dt * 3)
			if (pos - X.lastPos).Magnitude > allowed then
				root.CFrame = CFrame.new(X.lastPos) * (root.CFrame - root.CFrame.Position)
				pos = X.lastPos
				if os.clock() - lastNote > 2 then
					lastNote = os.clock()
					notify("Geri atma engellendi", "warn")
				end
			end
		end
		X.lastPos = pos

		acc += dt
		if acc < 0.15 then return end
		acc = 0
		local c = hum.Parent

		if S.enableJump then
			pcall(function()
				hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
				if hum.UseJumpPower then
					if hum.JumpPower < 30 then hum.JumpPower = 50 end
				elseif hum.JumpHeight < 4 then
					hum.JumpHeight = 7.2
				end
			end)
		end

		-- yaratik hasari: yaratigin parcalarinin dokunmasini kapat
		if S.noEntDmg then
			for inst, o in pairs(ents) do
				if o.cat == "entity" and (o.dist or 1e9) < 250 and os.clock() - (o.dmgT or 0) > 1.5
					and inst:IsDescendantOf(workspace) then
					o.dmgT = os.clock()
					for _, p in ipairs(inst:GetDescendants()) do
						if p:IsA("BasePart") and p.CanTouch then
							dmgOrig[p] = true
							p.CanTouch = false
						end
					end
				end
			end
		end
		-- yaratik yakindaysa KARAKTERIN dokunmasini da kapat (uzaklasinca geri acilir, kapilar bozulmaz)
		local nearEnt = false
		if S.noEntDmg then
			for _, o in pairs(ents) do
				if o.cat == "entity" and (o.dist or 1e9) < 40 then nearEnt = true; break end
			end
		end
		if nearEnt or S.charNoTouch then
			eachPart(c, function(p)
				if p.CanTouch then
					charOrig[p] = true
					p.CanTouch = false
				end
			end)
		elseif next(charOrig) then
			for p in pairs(charOrig) do
				if p.Parent then p.CanTouch = true end
			end
			table.clear(charOrig)
		end
		-- yaratik cok yaklasirsa guvenli noktaya kac
		if S.flee and os.clock() - lastFlee > 2 then
			for _, o in pairs(ents) do
				if o.cat == "entity" and o.dist and o.dist < S.fleeDist then
					local dest = X.safeCF or safePos
					if dest then
						lastFlee = os.clock()
						teleportTo(dest + Vector3.new(0, 5, 0))
						notify("Yaratık yaklaştı, kaçıldı", "warn")
					end
					break
				end
			end
		end

		if S.hideLook and os.clock() - (X.lookT or 0) > 1 then
			X.lookT = os.clock()
			X.hideLookers()
		end

		-- yaratik yaklasma hizindan "1 sn sonra dokunur" tahmini
		if S.dodge and not X.dodging then
			local now = os.clock()
			for _, o in pairs(ents) do
				if o.cat == "entity" and o.part and o.part:IsDescendantOf(workspace) then
					local d = (o.part.Position - root.Position).Magnitude
					local trigger = d < S.dodgeMin
					if o.pD and now > o.pT then
						local closing = (o.pD - d) / (now - o.pT)
						if closing > 2 and d / closing < S.dodgeTime then trigger = true end
					end
					o.pD, o.pT = d, now
					if trigger then
						X.dodgeAway()
						break
					end
				end
			end
		end

		if S.antiSlip then
			if slipChar ~= c then
				slipChar = c
				eachPart(c, function(p) p.CustomPhysicalProperties = SLIP_PROPS end)
			end
			rayParams.FilterDescendantsInstances = { c }
			local hit = workspace:Raycast(root.Position, Vector3.new(0, -8, 0), rayParams)
			local fp = hit and hit.Instance
			if fp and not fp:IsA("Terrain") and floorOrig[fp] == nil
				and (fp.Material == Enum.Material.Ice or fp.CurrentPhysicalProperties.Friction < 0.5) then
				floorOrig[fp] = fp.CustomPhysicalProperties or false
				fp.CustomPhysicalProperties = FLOOR_PROPS
			end
		end
	end
end

-- SONSUZ STAMINA / ENERJI, HIZLI ETKILESIM, ANTI-AFK
do
	local VirtualUser = game:GetService("VirtualUser")
	local maxSeen = setmetatable({}, { __mode = "k" })

	local function isStat(name)
		if name:lower():find("max", 1, true) then return false end
		return (S.infStamina and listHas(S.staminaNames, name)) or (S.infFood and listHas(S.foodNames, name))
	end
	local function numOf(c)
		if c and (c:IsA("NumberValue") or c:IsA("IntValue")) then return c.Value end
	end
	-- en yuksek gorulen deger (veya oyunun kendi Max degeri) kadar doldur
	local function maxFor(obj, name, current)
		local store = maxSeen[obj]
		if not store then store = {}; maxSeen[obj] = store end
		local m = math.max(store[name] or 0, current)
		for _, cand in ipairs({ "Max" .. name, name .. "Max", "Max_" .. name, name .. "_Max" }) do
			local v = obj:GetAttribute(cand)
			if typeof(v) ~= "number" then v = numOf(obj:FindFirstChild(cand)) end
			if typeof(v) == "number" and v > m then m = v end
		end
		store[name] = m
		return m
	end
	local function scanObj(obj)
		for name, val in pairs(obj:GetAttributes()) do
			if typeof(val) == "number" and isStat(name) then
				local m = maxFor(obj, name, val)
				if val < m then obj:SetAttribute(name, m) end
			end
		end
		for _, c in ipairs(obj:GetChildren()) do
			local v = numOf(c)
			if v and isStat(c.Name) then
				local m = maxFor(obj, c.Name, v)
				if v < m then c.Value = m end
			end
		end
	end
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		if not (S.infStamina or S.infFood) then return end
		acc += dt
		if acc < 0.15 then return end
		acc = 0
		scanObj(player)
		local char, hum = getChar(), getHum()
		if char then scanObj(char) end
		if hum then scanObj(hum) end
		for _, c in ipairs(player:GetChildren()) do
			if c:IsA("Folder") then scanObj(c) end
		end
		if char then
			for _, c in ipairs(char:GetChildren()) do
				if c:IsA("Folder") then scanObj(c) end
			end
		end
	end)

	-- ProximityPrompt: aninda etkilesim + uzaktan etkilesim
	local promptOrig = {}
	local function applyPrompt(p)
		if not p:IsA("ProximityPrompt") then return end
		if not promptOrig[p] then
			promptOrig[p] = { p.HoldDuration, p.MaxActivationDistance, p.RequiresLineOfSight }
		end
		local o = promptOrig[p]
		if S.fastPrompt then p.HoldDuration = 0 end
		local mult = S.farPrompt and S.promptMult or 1
		if S.doorReach then
			local a = p
			while a and a ~= workspace do
				if listHas(S.entDoors, a.Name) then
					mult = math.max(mult, S.promptMult)
					break
				end
				a = a.Parent
			end
		end
		if mult > 1 then p.MaxActivationDistance = o[2] * mult end
		if S.farPrompt or S.promptClip or mult > 1 then p.RequiresLineOfSight = false end
	end
	local promptScan = 0
	function X.refreshPrompts()
		promptScan += 1
		local id = promptScan
		for p, o in pairs(promptOrig) do
			if p.Parent then
				p.HoldDuration, p.MaxActivationDistance, p.RequiresLineOfSight = o[1], o[2], o[3]
			end
		end
		table.clear(promptOrig)
		if not (S.fastPrompt or S.farPrompt or S.promptClip or S.doorReach) then return end
		task.spawn(function()
			local n = 0
			for _, d in ipairs(workspace:GetDescendants()) do
				if id ~= promptScan then return end
				if d:IsA("ProximityPrompt") then applyPrompt(d) end
				n += 1
				if n % 1500 == 0 then task.wait() end
			end
		end)
	end
	X.onAdded(function(d)
		if (S.fastPrompt or S.farPrompt or S.promptClip or S.doorReach) and d:IsA("ProximityPrompt") then applyPrompt(d) end
	end)

	player.Idled:Connect(function()
		if S.antiAfk then
			pcall(function()
				VirtualUser:CaptureController()
				VirtualUser:ClickButton2(Vector2.new())
			end)
		end
	end)
end

