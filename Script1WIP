RunService.Stepped:Connect(function()
	local c, root, hum = getChar(), getRoot(), getHum()
	if not (c and root and hum) then return end
	if S.noclip then
		for _, p in ipairs(c:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
		if not S.flyOn then
			local v = root.AssemblyLinearVelocity
			local y = 0
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then y = S.noclipVert
			elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.Q) then y = -S.noclipVert end
			root.AssemblyLinearVelocity = Vector3.new(v.X, y, v.Z)
		end
	end
end)

RunService.Heartbeat:Connect(function(dt)
	local hum, root = getHum(), getRoot()
	if hum then
		if S.speedOn then
			if not X.speeding then X.speeding = true; X.cur = X.baseWalk end
			local step = S.speedRamp and S.rampRate * dt or math.huge
			X.cur = X.cur + math.clamp(S.speed - X.cur, -step, step)
			if S.speedMode == "WalkSpeed" then
				if hum.WalkSpeed ~= X.cur then hum.WalkSpeed = X.cur end
			else
				if hum.WalkSpeed ~= X.baseWalk then hum.WalkSpeed = X.baseWalk end
				local dir = hum.MoveDirection
				if root and not S.flyOn and dir.Magnitude > 0 then
					if S.speedMode == "Velocity" then
						local v = root.AssemblyLinearVelocity
						root.AssemblyLinearVelocity = Vector3.new(dir.X * X.cur, v.Y, dir.Z * X.cur)
					else
						root.CFrame = root.CFrame + dir * math.max(0, X.cur - X.baseWalk) * dt
					end
				end
			end
		else
			if X.speeding then X.speeding = false; hum.WalkSpeed = X.baseWalk end
			X.baseWalk = hum.WalkSpeed
		end
		if S.jumpOn then
			if not hum.UseJumpPower then hum.UseJumpPower = true end
			if hum.JumpPower ~= S.jump then hum.JumpPower = S.jump end
		end
		if S.godMode and hum.Health > 0 and hum.Health < hum.MaxHealth then hum.Health = hum.MaxHealth end
		if S.flyOn then hum.PlatformStand = true end
		if S.noAccel and root and not S.flyOn and hum.FloorMaterial ~= Enum.Material.Air and hum.MoveDirection.Magnitude < 0.01 then
			local v = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
		end
	end
	if S.gravityOn and workspace.Gravity ~= S.gravity then workspace.Gravity = S.gravity end
	if root and hum then
		X.update(dt, hum, root)
		if hum.FloorMaterial ~= Enum.Material.Air and root.Position.Y > S.voidY + 100 then
			safePos = root.CFrame
		end
		if S.antiVoid and root.Position.Y < S.voidY and safePos then
			teleportTo(safePos + Vector3.new(0, 5, 0))
		end
	end
end)

