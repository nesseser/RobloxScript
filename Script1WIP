local BUILTIN_IGNORE = "frame,knob,hinge,doorway,jamb,trim,handle,hitbox,hurtbox,terrain,camera,baseplate,spawnlocation,"
	.. "wall,floor,ceiling,rafter,pillar,strip,lightstand,chandelier,window,panel,cube,mesh,decal,glow,sign,start_,end_"
local function ignored(name)
	return listHas(BUILTIN_IGNORE, name) or listHas(S.entIgnore, name)
end

-- hangi tur? entity = humanoid / tehlikeli isim, door, hide (dolap vb.), item
local function classify(inst)
	if inst:IsA("Terrain") then return nil end
	local name = inst.Name
	if ENT_DB[name] and (inst:IsA("Model") or inst:IsA("BasePart")) then return "entity", true end
	if not inst:IsA("Model") then
		-- yerdeki Tool'lar ve tek parca kapi / esyalar
		if inst:IsA("Tool") then
			if S.entItem and inst.Parent and not inst.Parent:FindFirstChildOfClass("Humanoid") then return "item" end
			return nil
		end
		if inst:IsA("BasePart") and not ignored(name) then
			if S.entDoor and listHas(S.entDoors, name) then return "door" end
			if S.entItem and listHas(S.entItems, name) then return "item" end
			if S.entChest and listHas(S.entChests, name) then return "chest" end
			local x = extraCat(name)
			if x then return x end
		end
		return nil
	end
	if Players:GetPlayerFromCharacter(inst) then return nil end
	if ignored(name) then return nil end
	if inst:FindFirstChildOfClass("Humanoid") then return "entity", listHas(S.entDanger, name) end
	if listHas(S.entDanger, name) then return "entity", true end
	if S.entDoor and listHas(S.entDoors, name) then return "door" end
	if S.entHide and listHas(S.entHides, name) then return "hide" end
	if S.entItem and listHas(S.entItems, name) then return "item" end
	if S.entChest and listHas(S.entChests, name) then return "chest" end
	return extraCat(name)
end

