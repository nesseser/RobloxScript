local function short(v)
	local t = typeof(v)
	if t == "string" then
		return '"' .. (#v > 60 and v:sub(1, 60) .. "…" or v) .. '"'
	elseif t == "Instance" then
		return v:GetFullName()
	elseif t == "table" then
		local n = 0
		for _ in pairs(v) do n += 1 end
		return "{table:" .. n .. "}"
	end
	return tostring(v)
end

local hooked = {}
local function hookRemote(r)
	if hooked[r] or not r:IsA("RemoteEvent") then return end
	if r.Parent and r.Parent.Name == "DefaultChatSystemChatEvents" then return end
	hooked[r] = true
	r.OnClientEvent:Connect(function(...)
		local a = table.pack(...)
		local parts = {}
		for i = 1, math.min(a.n, 5) do parts[i] = short(a[i]) end
		if a.n > 5 then parts[#parts + 1] = "…" end
		addLog("remote", r.Name .. "(" .. table.concat(parts, ", ") .. ")")
	end)
end
