local function addSlider(page, text, min, max, default, cb, step, key)
	step = step or 1
	local r = row(page, 54)
	new("TextLabel", {
		Size = UDim2.new(1, -90, 0, 24), Position = UDim2.fromOffset(12, 4), BackgroundTransparency = 1, Text = text,
		TextColor3 = T.text, Font = Enum.Font.Gotham, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
	}, r)
	local valLbl = new("TextLabel", {
		Size = UDim2.new(0, 70, 0, 24), Position = UDim2.new(1, -82, 0, 4), BackgroundTransparency = 1, Text = fmt(default),
		TextColor3 = T.accent, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right,
	}, r)
	local track = new("Frame", { Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 38), BackgroundColor3 = T.stroke, BorderSizePixel = 0 }, r)
	round(track, 3)
	local fill = new("Frame", { Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BackgroundColor3 = T.accent, BorderSizePixel = 0 }, track)
	round(fill, 3)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
	}, fill)
	round(knob, 7)
	local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, -10), Text = "", BackgroundTransparency = 1 }, track)

	local curVal = default
	if key then
		registry[key] = {
			default = default, cb = cb, get = function() return curVal end,
			set = function(v)
				v = math.clamp(v, min, max)
				curVal = v
				fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
				valLbl.Text = fmt(v)
			end,
		}
	end
	local function setFromX(x, final)
		local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local v = math.floor((min + (max - min) * rel) / step + 0.5) * step
		v = math.clamp(v, min, max)
		fill.Size = UDim2.new((v - min) / (max - min), 0, 1, 0)
		valLbl.Text = fmt(v)
		curVal = v
		cb(v, final)
		if final then markDirty() end
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			activeSlider = setFromX
			setFromX(i.Position.X, false)
		end
	end)
end
UserInputService.InputChanged:Connect(function(i)
	if activeSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
		activeSlider(i.Position.X, false)
	end
end)
UserInputService.InputEnded:Connect(function(i)
	if activeSlider and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
